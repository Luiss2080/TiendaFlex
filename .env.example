# Copiar este archivo a .env y ajustar los valores para el entorno local.
# .env está en .gitignore -- nunca commitear el archivo real con datos reales.

# --- Aplicación (ver config/app.php) ---
APP_NAME="TiendaFlex"
APP_URL=http://localhost/PaginaWebFLEX
APP_ENV=local
APP_DEBUG=true

# --- Sesión (ver config/app.php) ---
SESSION_LIFETIME=7200
SESSION_NAME=zay_session

# --- Base de datos (ver config/database.php y app/core/Database.php) ---
# Solo hace falta si vas a ejercitar rutas que consultan la base de
# datos real; el catálogo de ejemplo (home, shop, ficha de producto,
# categorías) funciona sin base de datos gracias a los datos de
# muestra en Product::getSampleProducts().
DB_HOST=localhost
DB_PORT=3306
DB_NAME=zay_shop
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
